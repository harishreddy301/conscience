# Copy to ~/.job-hunter/.env (outside the repo). Leave a key empty and the
# session-start check will remind you; delete the line if you don't use that source.
# Paths (leave empty for the defaults). `jh me init --dir <path>` writes JOB_HUNTER_ME for you.
# Use forward slashes on Windows, e.g. JOB_HUNTER_ME="D:/Projects/Job_Hunter/me".
JOB_HUNTER_HOME=                 # machine state: db, artifacts, logs (default ~/.job-hunter)
JOB_HUNTER_ME=                   # your me/ workspace (default <JOB_HUNTER_HOME>/me)
JOB_HUNTER_DB=                   # SQLite file (default <JOB_HUNTER_HOME>/jh.db)
CHROME_PATH=                     # headless Chrome for PDF rendering (auto-detected if empty)

# Scraping fallback for job boards (Indeed, Glassdoor, Google Jobs, Dice, ...)
APIFY_TOKEN=

# Job aggregator APIs
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
USAJOBS_API_KEY=
USAJOBS_EMAIL=
JOOBLE_API_KEY=
RAPIDAPI_KEY=          # JSearch (Google Jobs aggregate)
SERPAPI_KEY=           # Google Jobs engine

# Web search / research (company discovery, interview prep)
EXA_API_KEY=
FIRECRAWL_API_KEY=
